{
  "manifest_version": 3,
  "name": "Autocity Marketplace Publisher",
  "version": "3.8",
  "description": "Autocompleta vehiculos y fotos desde AppSheet en Facebook Marketplace",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.asofix.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/marketplace/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://lautajuarez1.github.io/autocity-bounce/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
